{
    "name": "@doist/cli-core",
    "version": "1.0.1",
    "description": "Shared core utilities for Doist CLI projects",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./auth": {
            "types": "./dist/auth/index.d.ts",
            "import": "./dist/auth/index.js"
        },
        "./commands": {
            "types": "./dist/commands/index.d.ts",
            "import": "./dist/commands/index.js"
        },
        "./markdown": {
            "types": "./dist/markdown.d.ts",
            "import": "./dist/markdown.js"
        },
        "./testing": {
            "types": "./dist/testing/index.d.ts",
            "import": "./dist/testing/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch",
        "type-check": "tsc --noEmit",
        "check": "oxlint src && oxfmt --check",
        "fix": "oxlint src --fix && oxfmt",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest",
        "prepublishOnly": "npm run build && npm test"
    },
    "keywords": [
        "cli",
        "doist"
    ],
    "author": "Doist",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Doist/cli-core.git"
    },
    "homepage": "https://github.com/Doist/cli-core#readme",
    "bugs": {
        "url": "https://github.com/Doist/cli-core/issues"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "engines": {
        "node": ">=24",
        "npm": ">=11"
    },
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "devDependencies": {
        "@semantic-release/changelog": "6.0.3",
        "@semantic-release/exec": "7.1.0",
        "@semantic-release/git": "10.0.1",
        "@types/node": "25.9.5",
        "commander": "14.0.3",
        "conventional-changelog-conventionalcommits": "9.3.1",
        "lefthook": "2.1.10",
        "marked": "18.0.7",
        "marked-terminal-renderer": "2.2.0",
        "oauth4webapi": "3.8.6",
        "open": "11.0.0",
        "oxfmt": "0.59.0",
        "oxlint": "1.74.0",
        "semantic-release": "25.0.8",
        "typescript": "6.0.3",
        "vitest": "4.1.10"
    },
    "dependencies": {
        "chalk": "5.6.2",
        "yocto-spinner": "1.2.2"
    },
    "optionalDependencies": {
        "@napi-rs/keyring": "1.3.0"
    },
    "peerDependencies": {
        "commander": ">=14",
        "marked": ">=18",
        "marked-terminal-renderer": ">=2",
        "oauth4webapi": ">=3",
        "open": ">=10",
        "vitest": ">=4.1"
    },
    "peerDependenciesMeta": {
        "commander": {
            "optional": true
        },
        "marked": {
            "optional": true
        },
        "marked-terminal-renderer": {
            "optional": true
        },
        "oauth4webapi": {
            "optional": true
        },
        "open": {
            "optional": true
        },
        "vitest": {
            "optional": true
        }
    }
}
